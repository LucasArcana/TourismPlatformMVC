@model TourismPlatformMVC.ViewModels.HomeDashboardViewModel
@{
    ViewBag.Title = "Tourist Dashboard";
}

@if (TempData["SeedMessage"] != null)
{
    <div class="alert alert-info">
        @TempData["SeedMessage"]
    </div>
}

<!-- HERO BANNER (online image - direct file, no redirects) -->
<div class="hero-landing"
     style="background-image:url('https://upload.wikimedia.org/wikipedia/commons/thumb/1/1c/Mountain_panorama.jpg/1920px-Mountain_panorama.jpg')">
    <div class="hero-overlay">
        <div class="hero-content">
            <div class="hero-kicker">Tourism Platform</div>

            <h1 class="hero-title">Plan trips. Book tours. Explore more.</h1>

            <p class="hero-subtitle">
                Browse packages, book guided tours, and manage your bookings in one place.
            </p>

            <div class="hero-actions">
                <a class="btn btn-success btn-lg" href="@Url.Action("Login","Account")">Login</a>
                <a class="btn btn-default btn-lg btn-ghost" href="@Url.Action("Register","Account")">Sign Up</a>
            </div>

            <div class="hero-badges">
                <span><span class="glyphicon glyphicon-lock"></span> Secure accounts</span>
                <span><span class="glyphicon glyphicon-calendar"></span> Flexible dates</span>
                <span><span class="glyphicon glyphicon-star"></span> Ratings &amp; feedback</span>
            </div>
        </div>
    </div>
</div>

<!-- Temporary button -->

@if (Request.IsAuthenticated)
{
    <div class="section-gap">
        <a class="btn btn-default" href="@Url.Action("SeedDemoData","Home")">
            Seed Demo Data (Debug)
        </a>
    </div>
}


<!-- FEATURES -->
<div class="row section-gap">
    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-icon"><span class="glyphicon glyphicon-user"></span></div>
            <h3 class="feature-title">Profiles</h3>
            <p class="feature-text">
                Agencies &amp; tour guides can manage their services, images, and packages.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-icon"><span class="glyphicon glyphicon-ok-circle"></span></div>
            <h3 class="feature-title">Easy Booking</h3>
            <p class="feature-text">
                Tourists can book tours, track status, and view booking history.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-icon"><span class="glyphicon glyphicon-comment"></span></div>
            <h3 class="feature-title">Feedback</h3>
            <p class="feature-text">
                Collect ratings and reviews after each trip to improve experiences.
            </p>
        </div>
    </div>
</div>

<!-- POPULAR DESTINATIONS -->
<div class="card section-gap">
    <div class="section-head">
        <h2 class="section-title">Featured Travel Packages</h2>
        <div class="section-note">Latest packages from the database</div>
    </div>

    @if (Model.FeaturedPackages == null || !Model.FeaturedPackages.Any())
    {
        <div class="alert alert-info" style="margin:0;">
            No travel packages found yet. Add some packages to see them here.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var p in Model.FeaturedPackages)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="feature-card" style="height:100%;">
                        <h3 class="feature-title" style="margin-top:0;">@p.Name</h3>
                        <p class="feature-text" style="margin-bottom:10px;">
                            <strong>Destination:</strong> @p.Destination
                        </p>
                        <p class="feature-text" style="margin-bottom:15px;">
                            <strong>Price:</strong> @p.Price.ToString("C")
                        </p>

                        <div>
                            <a class="btn btn-success btn-sm"
                               href="@Url.Action("Index", "TourSchedules")">
                                View Details
                            </a>
                            <a class="btn btn-default btn-sm"
                               href="@Url.Action("Index", "TourSchedules", new { travelPackageId = p.TravelPackageId })">
                                See Dates
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- TRAVEL PACKETS ) -->

<div class="card section-gap">
    <div class="section-head">
        <h2 class="section-title">Upcoming Tour Schedules</h2>
        <div class="section-note">Next available tours from @Model.Today.ToString("dd MMM yyyy")</div>
    </div>

    @if (Model.UpcomingSchedules == null || !Model.UpcomingSchedules.Any())
    {
        <div class="alert alert-info" style="margin:0;">
            No upcoming tours available right now.
        </div>
    }
    else
    {
        <table class="green-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Package</th>
                    <th>Destination</th>
                    <th>Duration</th>
                    <th>Group Limit</th>
                    <th>Price</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.UpcomingSchedules)
                {
                    <tr>
                        <td>@s.AvailableDate.ToString("dd MMM yyyy")</td>
                        <td>@s.PackageName</td>
                        <td>@s.Destination</td>
                        <td>@s.DurationDays day(s)</td>
                        <td>@s.GroupSizeLimit</td>
                        <td>@s.Price.ToString("C")</td>
                        <td style="white-space:nowrap;">
                            <a class="btn btn-success btn-xs"
                               href="@Url.Action("Create", "Bookings", new { tourScheduleId = s.TourScheduleId })">
                                Book
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>



<!-- GROUP MEMBERS (REQUIREMENT) -->
<div class="card section-gap">
    <div class="section-head">
        <h2 class="section-title">ICT272 Group 2 Members</h2>
        <div class="section-note">Assessment requirement</div>
    </div>

    <table class="green-table">
        <thead>
            <tr>
                <th>Student ID</th>
                <th>Full Name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.GroupMembers)
            {
                <tr>
                    <td>@m.StudentId</td>
                    <td>@m.FullName</td>
                </tr>
            }
        </tbody>
    </table>
</div>
